"""
Data Extraction and Preprocessing Module
----------------------------------------
Extracts environmental time-series and harvest yield metrics from the raw 
Wageningen University & Research (WUR) 4th Autonomous Greenhouse Challenge 
dataset (Compartment 3.06 - Reference Strategy).

Source Dataset:
Maree et al. (2025), "Autonomous Greenhouse Cultivation of Dwarf Tomato", 
MDPI Sensors / 4TU.ResearchData.
"""

from pathlib import Path
import pandas as pd


def extract_greenhouse_climate_data(
    input_filepath: str = "../data/raw/reference.csv",
    output_filepath: str = "../data/sample_greenhouse_climate.csv",
    hours_to_extract: int = 168,
) -> pd.DataFrame:
    """Extracts and standardizes microclimate time-series parameters."""
    target_columns = {
        "time": "time",
        "compartment/air_temperature": "temp_c",
        "compartment/relative_humidity": "rh_pct",
        "compartment/par": "par_ppfd",
        "compartment/co2_concentration": "co2_ppm",
    }

    df_raw = pd.read_csv(input_filepath)
    df_climate = df_raw[list(target_columns.keys())].dropna()
    df_climate = df_climate.rename(columns=target_columns)

    # Standardize timestamp parsing
    df_climate["time"] = pd.to_datetime(df_climate["time"])

    # Extract initial time frame (default: 1 week / 168 hourly records)
    df_subset = df_climate.head(hours_to_extract)

    # Export sanitized output
    Path(output_filepath).parent.mkdir(parents=True, exist_ok=True)
    df_subset.to_csv(output_filepath, index=False)

    return df_subset


def extract_harvest_summary_data(
    input_filepath: str = "../data/raw/Harvest.xlsx",
    output_filepath: str = "../data/harvest_summary.csv",
    sheet_name: str = "Final Harvest  3.06",
) -> pd.DataFrame:
    """Parses and exports harvest yield validation metrics for Compartment 3.06."""
    df_harvest = pd.read_excel(input_filepath, sheet_name=sheet_name)

    # Clean empty rows/columns from raw sheet
    df_harvest_clean = df_harvest.dropna(how="all").reset_index(drop=True)

    # Export sanitized output
    Path(output_filepath).parent.mkdir(parents=True, exist_ok=True)
    df_harvest_clean.to_csv(output_filepath, index=False)

    return df_harvest_clean


if __name__ == "__main__":
    climate_df = extract_greenhouse_climate_data()
    harvest_df = extract_harvest_summary_data()
